VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Set to "true" only after supabase/functions/parse-campaign is deployed and
# smoke-tested against a real project. Until then, leave unset (or "false") so
# EdgeFunctionParser.isAvailable() stays false and the app falls back to the
# paste-JSON path instead of calling a function that isn't there.
VITE_PARSE_CAMPAIGN_DEPLOYED=false
